    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{ json: { mailsText: 'Aucun mail recu.', count: 0, mailsJson: '[]' } }];\n}\n\nconst mails = items.map((item) => {\n  const mail = item.json;\n  const id = mail.id || mail.messageId || '';\n  const threadId = mail.threadId || '';\n  const from = (mail.headers && mail.headers.From) || mail.From || mail.from || 'Inconnu';\n  const subject = (mail.headers && mail.headers.Subject) || mail.Subject || mail.subject || '(Sans objet)';\n  const snippet = (mail.snippet || '').replace(/[\\u200c\\u00ad\\u200b\\ufeff]/g, '').replace(/&#39;/g, \"'\").trim().slice(0, 300);\n  return { id, threadId, from, subject, snippet };\n});\n\nconst mailsText = mails.map((m, i) =>\n  `${i + 1}. De: ${m.from}\\nObjet: ${m.subject}\\nApercu: ${m.snippet}`\n).join('\\n\\n---\\n\\n');\n\nreturn [{ json: { mailsText, count: mails.length, mailsJson: JSON.stringify(mails) } }];"
      },
      "id": "41a1b7d6-6768-41cd-a67b-0037dcba708f",
      "name": "FormatterLesMails",
