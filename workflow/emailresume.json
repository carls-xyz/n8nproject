    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst body = JSON.stringify({\n  model: 'llama-3.3-70b-versatile',\n  max_tokens: 1024,\n  messages: [\n    {\n      role: 'system',\n      content: 'Tu es un assistant personnel de Charles. Tu analyses ses emails des dernieres 24h et tu rediges un resume en francais pour Telegram.\\n\\nRegles :\\n- Ignore newsletters, pubs et notifications automatiques\\n- Concentre-toi uniquement sur les mails importants\\n- Si tout est spam, dis-le avec humour\\n\\nFormat STRICT :\\n🌅 Bonjour Charles ! Voici ton recap mail du jour\\n\\n📬 X mails importants sur Y recus\\n\\n1️⃣ [Emoji] De : [Expediteur]\\n📌 Sujet : [Sujet]\\n✅ Action : [1 phrase max]\\n\\n2️⃣ ...'\n    },\n    {\n      role: 'user',\n      content: 'Voici les ' + data.count + ' emails recus :\\n\\n' + data.mailsText\n    }\n  ]\n});\n\nreturn [{ json: { body, mailsJson: data.mailsJson } }];"
      },
