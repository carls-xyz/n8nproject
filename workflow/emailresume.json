    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nlet text = response?.choices?.[0]?.message?.content || 'Aucun resume genere.';\n\ntext = text\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<b>$1</b>').replace(/\\*(.*?)\\*/g, '<i>$1</i>')\n  .replace(/^#{1,3} (.+)$/gm, '<b>$1</b>').replace(/^[\\*\\-] /gm, '• ');\n\nconst mailsJson = $('PrepareResume').first().json.mailsJson;\nreturn [{ json: { summary: text, mailsJson } }];"
      },
